# Matriks — Frontend environment variables
# Salin file ini menjadi `.env` lalu isi nilainya:
#   cp .env.example .env
#
# JANGAN commit file `.env` (sudah di-ignore git). File ini hanya template.

# Supabase Project URL (Dashboard → Settings → API → Project URL)
REACT_APP_SUPABASE_URL=

# Supabase anon / publishable key (Dashboard → Settings → API → anon public)
REACT_APP_SUPABASE_ANON_KEY=

# Email admin (owner) — dipisah koma. Hanya email di sini yang bisa pakai AI Chat (fallback).
REACT_APP_ADMIN_EMAILS=

# --- AI Chat ---
# REKOMENDASI PRODUKSI: pakai Edge Function proxy (API key TIDAK di frontend)
# Deploy: supabase functions deploy ai-chat
# Secret: supabase secrets set KIMI_API_KEY=sk-...
REACT_APP_AI_PROXY_URL=
# Contoh: https://YOUR_PROJECT.supabase.co/functions/v1/ai-chat

# Fallback development only — API key langsung di browser (TIDAK AMAN untuk production)
REACT_APP_KIMI_API_KEY=

# Model (opsional, default kimi-k3)
REACT_APP_AI_MODEL=kimi-k3
