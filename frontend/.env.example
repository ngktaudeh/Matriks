# Matriks — Frontend environment variables
# Salin file ini menjadi `.env` lalu isi nilainya:
#   cp .env.example .env
#
# JANGAN commit file `.env` (sudah di-ignore git). File ini hanya template.

# Supabase Project URL (Dashboard → Settings → API → Project URL)
REACT_APP_SUPABASE_URL=

# Supabase anon / publishable key (Dashboard → Settings → API → anon public)
REACT_APP_SUPABASE_ANON_KEY=

# Email admin (owner) — dipisah koma. Hanya email di sini yang bisa pakai AI Chat.
REACT_APP_ADMIN_EMAILS=

# Kimi (Moonshot) API key untuk fitur AI Chat.
# Domain internasional: https://platform.moonshot.ai
REACT_APP_KIMI_API_KEY=
